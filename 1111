        // Calculate Real-Time KPI Dashboard Scores
        function calculateKPIs() {
            const t = translations[currentLang];
            const totalItems = ctqItems.length;
            
            let passedCount = 0;
            let failedCount = 0;
            let evaluatedCount = 0;

            ctqItems.forEach(item => {
                if (item.result === 'YES') {
                    passedCount++;
                    evaluatedCount++;
                } else if (item.result === 'NO') {
                    failedCount++;
                    evaluatedCount++;
                }
            });

            const totalScore = passedCount; // YES = 1, NO = 0
            
            // Compliance Rate calculation: Total Score / Total Items * 100%
            let compliancePercent = (totalItems > 0) ? Math.round((totalScore / totalItems) * 100) : 0;

            // DOM Updates
            document.getElementById('val-total-score').innerText = `${totalScore} / ${totalItems}`;
            document.getElementById('val-passed-count').innerText = passedCount;
            document.getElementById('val-failed-count').innerText = failedCount;
            document.getElementById('val-compliance').innerText = `${compliancePercent}%`;

            // Progress Bar Fill
            const progressFill = document.getElementById('progress-fill');
            progressFill.style.width = `${compliancePercent}%`;

            // Status Badge Logic
            const badgeEl = document.getElementById('badge-compliance-status');

            if (evaluatedCount === 0) {
                badgeEl.className = "status-badge badge-warning";
                badgeEl.innerHTML = `<i class="fa-solid fa-clock"></i> <span>${t.statusPending}</span>`;
                progressFill.style.backgroundColor = 'var(--primary)';
            } else if (compliancePercent >= 95) {
                badgeEl.className = "status-badge badge-pass";
                badgeEl.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>${t.statusPass}</span>`;
                progressFill.style.backgroundColor = 'var(--success)';
            } else if (compliancePercent >= 85) {
                badgeEl.className = "status-badge badge-warning";
                badgeEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> <span>${t.statusWarning}</span>`;
                progressFill.style.backgroundColor = 'var(--warning)';
            } else {
                badgeEl.className = "status-badge badge-fail";
                badgeEl.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> <span>${t.statusFail}</span>`;
                progressFill.style.backgroundColor = 'var(--danger)';
            }
        }

        // Action: Save Current Audit Session to History
        function saveAuditRecord() {
            const lineVal = document.getElementById('meta-line').value.trim() || 'Line 01';
            const styleVal = document.getElementById('meta-style').value.trim() || 'Style-01';
            const articleVal = document.getElementById('meta-article').value.trim() || 'Article-01';
            const inspectorVal = document.getElementById('meta-inspector').value.trim() || '-';
            const dateVal = document.getElementById('meta-date').value || new Date().toISOString().split('T')[0];
            const shiftVal = document.getElementById('meta-shift').value || 'Day';

            let passedCount = 0;
            let failedCount = 0;
            ctqItems.forEach(item => {
                if (item.result === 'YES') passedCount++;
                if (item.result === 'NO') failedCount++;
            });

            const totalItems = ctqItems.length;
            const totalScore = passedCount;
            const compliancePercent = (totalItems > 0) ? Math.round((totalScore / totalItems) * 100) : 0;

            const record = {
                id: 'audit_' + Date.now(),
                savedAt: new Date().toLocaleString(currentLang === 'th' ? 'th-TH' : 'en-US'),
                line: lineVal,
                style: styleVal,
                article: articleVal,
                inspector: inspectorVal,
                date: dateVal,
                shift: shiftVal,
                totalScore: totalScore,
                totalItems: totalItems,
                passedCount: passedCount,
                failedCount: failedCount,
                compliancePercent: compliancePercent,
                items: JSON.parse(JSON.stringify(ctqItems))
            };

            // Prepend new record
            auditHistory.unshift(record);
            saveAuditHistoryToStorage();
            showToast(translations[currentLang].toastSavedSuccess);
        }

