        // Action: Export Specific Historical Record to Excel directly
        function exportHistoryRecordToExcel(id) {
            const rec = auditHistory.find(r => r.id === id);
            if (!rec) return;

            const reportData = [
                ["รายงานการตรวจสอบ CTQ ย้อนหลัง / Historical CTQ Audit Report"],
                [],
                ["ข้อมูลการตรวจสอบ (Header Details)"],
                ["ไลน์ผลิต (Line):", rec.line, "สไตล์ (Style):", rec.style],
                ["สี / Article:", rec.article, "ผู้ตรวจสอบ (Auditor):", rec.inspector],
                ["วันที่ (Date):", rec.date, "กะการทำงาน (Shift):", rec.shift],
                ["คะแนนรวม (Total Score):", `${rec.totalScore} / ${rec.totalItems}`, "% ความสอดคล้อง (% Compliance):", `${rec.compliancePercent}%`],
                ["เวลาที่บันทึก (Saved At):", rec.savedAt],
                [],
                ["#", "ไลน์ผลิต (Line)", "สไตล์ (Style)", "สี / Article", "หัวข้อตรวจสอบ CTQ (CTQ Requirement)", "ผลการตรวจสอบ (Result)", "คะแนน (Score)", "หมายเหตุ (Comment)"]
            ];

            rec.items.forEach((item, index) => {
                let title = (currentLang === 'th') ? (item.titleTh || item.titleEn) : (item.titleEn || item.titleTh);
                let scoreNum = (item.result === 'YES') ? 1 : (item.result === 'NO' ? 0 : "");
                let resultText = item.result || "PENDING";

                reportData.push([
                    index + 1,
                    rec.line,
                    rec.style,
                    rec.article,
                    title,
                    resultText,
                    scoreNum,
                    item.comment || ""
                ]);
            });

            if (typeof XLSX !== 'undefined') {
                const worksheet = XLSX.utils.aoa_to_sheet(reportData);
                worksheet['!cols'] = [
                    { wch: 6 }, { wch: 14 }, { wch: 16 }, { wch: 16 }, { wch: 45 }, { wch: 15 }, { wch: 10 }, { wch: 30 }
                ];
                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "CTQ_Audit_History");
                const fileName = `CTQ_History_${rec.line}_${rec.style}_${rec.date}.xlsx`.replace(/\s+/g, '_');
                XLSX.writeFile(workbook, fileName);
            } else {
                exportToCSV(reportData, rec.line, rec.style, rec.date);
            }
        }

