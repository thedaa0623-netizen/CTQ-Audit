            const complianceText = document.getElementById('val-compliance').innerText;

            // Prepare Data Rows
            const reportData = [
                ["รายงานการตรวจสอบ CTQ / CTQ Audit Report"],
                [],
                ["ข้อมูลการตรวจสอบ (Header Details)"],
                ["ไลน์ผลิต (Line):", lineVal, "สไตล์ (Style):", styleVal],
                ["สี / Article:", articleVal, "ผู้ตรวจสอบ (Auditor):", inspectorVal],
                ["วันที่ (Date):", dateVal, "กะการทำงาน (Shift):", shiftVal],
                ["คะแนนรวม (Total Score):", totalScoreText, "% ความสอดคล้อง (% Compliance):", complianceText],
                [],
                ["#", "ไลน์ผลิต (Line)", "สไตล์ (Style)", "สี / Article", "หัวข้อตรวจสอบ CTQ (CTQ Requirement)", "ผลการตรวจสอบ (Result)", "คะแนน (Score)", "หมายเหตุ (Comment)"]
            ];

            ctqItems.forEach((item, index) => {
                let title = (currentLang === 'th') ? (item.titleTh || item.titleEn) : (item.titleEn || item.titleTh);
                let scoreNum = (item.result === 'YES') ? 1 : (item.result === 'NO' ? 0 : "");
                let resultText = item.result || "PENDING";

                reportData.push([
                    index + 1,
                    lineVal,
                    styleVal,
                    articleVal,
                    title,
                    resultText,
                    scoreNum,
                    item.comment || ""
                ]);
            });

            // Check if SheetJS library is loaded
            if (typeof XLSX !== 'undefined') {
                const worksheet = XLSX.utils.aoa_to_sheet(reportData);
                
                // Set Column Widths for readability
                worksheet['!cols'] = [
                    { wch: 6 },  // #
                    { wch: 14 }, // Line
                    { wch: 16 }, // Style
                    { wch: 16 }, // Article
                    { wch: 45 }, // CTQ Item
                    { wch: 15 }, // Result
                    { wch: 10 }, // Score
                    { wch: 30 }  // Comment
                ];

                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "CTQ_Audit");
                
                const fileName = `CTQ_Audit_${lineVal}_${styleVal}_${dateVal}.xlsx`.replace(/\s+/g, '_');
                XLSX.writeFile(workbook, fileName);
            } else {
                // Fallback CSV Export if offline or SheetJS CDN unavailable
                exportToCSV(reportData, lineVal, styleVal, dateVal);
            }
        }

        // Fallback UTF-8 CSV Export
        function exportToCSV(data, line, style, date) {
            let csvContent = "\uFEFF"; // UTF-8 BOM for Thai encoding in MS Excel
            data.forEach(row => {
                const formattedRow = row.map(cell => `"${String(cell).replace(/"/g, '""')}"`);
                csvContent += formattedRow.join(",") + "\r\n";
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            const fileName = `CTQ_Audit_${line}_${style}_${date}.csv`.replace(/\s+/g, '_');
            link.setAttribute("download", fileName);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Helper: Toast Notifications
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `<i class="fa-solid fa-circle-info"></i> ${escapeHtml(message)}`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Helper: Escape HTML string
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
